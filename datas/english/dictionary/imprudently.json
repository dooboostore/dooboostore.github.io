  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "네가 그런 말을 하다니 경솔했구나.",
      "text": "It was <b>imprudent</b> of you to say so.=You were <b>imprudent</b> to say so."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "나는 부주의하게도 그런 사람을 신용했다",
      "text": "I was <b>imprudent</b> enough to trust the man."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그런 경솔한 짓을 하다니 그 사람 돌았군.",
      "text": "He must be mad to do such an <b>imprudent</b> thing."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그런 말을 하다니 지각없는 짓을 했구나",
      "text": "It was <b>imprudent</b> of you to say so. or You were <b>imprudent</b> to say so."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "나는 그의 말에 부아가 났다",
      "text": "I was exasperated at his words. or His (<b>imprudent</b>) words stung[cut] me to the quick."
    }
  ],
