  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "사제는 그의 참회를 들었다.",
      "text": "A priest received his <b>confession</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그는 그녀를 유도하여 자백시켰다.",
      "text": "He entrapped her into making <b>confession</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그것은 너의 무식함을 고백하는 거나 다름없다",
      "text": "That practically amounts to a <b>confession</b> of your own ignorance. or That itself tells of your ignorance."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "고백은 참회의 표시이다",
      "text": "<b>Confession</b> is one mark of repentance."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "피고는 유죄를 자인했다",
      "text": "The accused made acknowledgment[<b>confession</b>] of his guilt."
    }
  ],
