  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "나는 양심의 가책을 느낀다.",
      "text": "My <b>conscience</b> smites me."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "나는 양심의 가책을 받았다.",
      "text": "My <b>conscience</b> pricked me."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그것은 그의 양심을 괴롭혔다",
      "text": "It weighed upon his <b>conscience</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그는 양심이 마비되어 있다",
      "text": "He is dead[lost] to <b>conscience</b>. or His <b>conscience</b> is benumbed."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "누구든지 밑이 구린 데가 있는 법이다",
      "text": "Every man has a bad <b>conscience</b>."
    }
