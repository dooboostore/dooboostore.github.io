  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그의 죄는 모두 소멸해 버렸다",
      "text": "His sins are all blotted out."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "시간의 낭비는 일종의 죄악이다",
      "text": "Waste of time is a sort of <b>sin</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "한 번도 죄를 범한 적이 없기는 불가능하다.",
      "text": "Never to have sinned[To have never sinned] is impossible."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그녀가 죽자 그는 죄의식을 깨달았다.",
      "text": "Her death awoke him to a sense of <b>sin</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
