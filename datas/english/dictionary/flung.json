  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "실컷 놀게 내버려 둬라!",
      "text": "Let him have his <b>fling</b>!"
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그는 그 일에 몰두하였다.",
      "text": "He <b>flung</b> himself on[into] the work."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그는 책상에 책을 내던졌다.",
      "text": "He <b>flung</b> his books on the desk."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그는 나의 관대함에 매달렸다.",
      "text": "He <b>flung</b> himself on my generosity."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그녀는 어머니의 팔에 자기 몸을 던졌다.",
      "text": "She <b>flung</b> herself into her mother’s arms."
    }
  ],
