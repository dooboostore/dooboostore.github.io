  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "총리는 여야 쌍방으로부터 몹시 들이몰렸다",
      "text": "The Prime Minister came under heavy fire from his own party as well as from the <b>opposition</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "반대하는 것이 야당이 해야 할 일이다.",
      "text": "It is the job of the <b>Opposition</b> to oppose."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "야당은 내각의 총퇴진을 요구했다",
      "text": "The <b>Opposition</b> requested the Cabinet to resign en bloc."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그녀는 태도를 바꾸어 반대파를 위해 설득했다.",
      "text": "She wheeled around and argued for the <b>opposition</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "민주당 후보는 상대를 훨씬 앞질렀다",
      "text": "The Democratic candidate has left the <b>opposition</b> standing."
    }
