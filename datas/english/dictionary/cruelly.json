  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그런 짓을 하는 것은 잔인하다",
      "text": "It is <b>cruel</b> to do such a thing."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그들은 무자비한 방법으로 죽은 사람의 원한을 갚았다.",
      "text": "They revenged their dead <b>cruelly</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "나는 그러한 야멸스러운 짓을 못한다",
      "text": "I have not the heart to do such a <b>cruel</b> thing."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그는 게릴라의 손에 참사했다",
      "text": "He was <b>cruelly</b> murdered at the hands of the guerrillas."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그는 나를 냉혹하게 대했다",
      "text": "He did something very <b>cruel</b> to me. or He treated me mercilessly."
