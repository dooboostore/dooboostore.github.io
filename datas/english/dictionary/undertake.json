  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그것은 꽤 큰 사업이다.",
      "text": "It’s quite an undertaking."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그렇게 손쉽게 인수할 수는 없다",
      "text": "I can't <b>undertake</b> it so readily."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "오냐 그 일은 내가 맡겠다",
      "text": "All right. I will <b>undertake</b> the work."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "내가 맡은 사업은 모조리 실패였다",
      "text": "In everything I undertook I failed."
    },
    {
      "source": "동아출판 프라임 영한사전",
