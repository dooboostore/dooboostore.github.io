  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "자기가 뿌린 씨는 자기가 거두어야 한다",
      "text": "You must <b>reap</b> what you have sown."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "어떤 일을 하든지 밑천이 든다",
      "text": "You must sow[give] before you can <b>reap</b>[take]."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "이것은 그의 젊은 시절의 무절제와 방종에 대한 인과응보다",
      "text": "He is only reaping what he has sown in his youth of uncontrolled vice and licentiousness."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "씨를 뿌려야 거둔다.",
      "text": "You must sow before you can <b>reap</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "선손질 후방망이",
      "text": "He who sows the wind shall <b>reap</b> the whirlwind."
    }
