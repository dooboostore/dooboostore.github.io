  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "꾸물대는 꼴이 정말 안타깝다",
      "text": "I am <b>impatient</b> at your slowness."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "네가 늦어서 그는 등이 달았다",
      "text": "He was vexed[<b>impatient</b>] at your delay."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그는 가고 싶어 들먹거리고 있다",
      "text": "He is <b>impatient</b>[all eagerness] to go."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "아이들은 빨리 가고 싶어서 안달하고 있다.",
      "text": "The children are <b>impatient</b> to go."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그리 급히 굴 것은 없어",
      "text": "There is no hurry. or What's the hurry? or Don't be so <b>impatient</b>."
    }
