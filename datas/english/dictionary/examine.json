  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그는 친절하게도 그것을 조사해 주었다",
      "text": "He was kind[good] enough to <b>examine</b> it. or He had the goodness[kindness] to <b>examine</b> it for me."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "나는 어제 눈을 진찰받았다",
      "text": "I had my eyes examined yesterday."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그 결정을 이해하려면 그에 앞서는 과정을 살펴보아야 할 것이다",
      "text": "In order to understand the decision, you have to <b>examine</b> the process that led up to it."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "머리가 어떻게 되었나 진찰을 받아보지 그래.",
      "text": "You should have your head examined[tested, seen to]."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그의 이번 학기 결석 횟수를 조사해 주시오",
      "text": "Please <b>examine</b> how many times he was absent this term."
    }
