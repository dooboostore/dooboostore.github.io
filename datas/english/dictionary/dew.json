  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "인생이란 이를테면 아침 이슬과 같은 것이다",
      "text": "Our life is, so to speak, a morning <b>dew</b>. or Our life may be likened to a morning <b>dew</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "사람의 목숨은 이슬처럼 덧없는 것이다",
      "text": "Man's life is as transient as <b>dew</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "인생은 초로와 같이 덧없이 가 버린다",
      "text": "Life is as evanescent as morning <b>dew</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "빨래가 이슬에 축축하다",
      "text": "The laundry is moist with <b>dew</b>."
