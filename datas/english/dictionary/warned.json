  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "두 번 다시 경고하지 않겠다!",
      "text": "I shall not <b>warn</b> you again!"
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그는 나에게 문에서 떨어지라고 경고했다",
      "text": "He <b>warned</b> me off the gate."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그는 나의 경고를 무시했다",
      "text": "He paid no attention to my warnings."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "수회 경고했으나 그는 듣지 않았다",
      "text": "My repeated warnings were lost upon him."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "승객 여러분, 소매치기에 조심하십시오.",
      "text": "Passengers are <b>warned</b> against pickpockets."
