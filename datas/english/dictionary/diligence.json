  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "근면 덕분에 오늘날의 톰이 있다.",
      "text": "<b>Diligence</b> has made Tom what he is."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "근면은 성공의 확실한 보증이다.",
      "text": "<b>Diligence</b> is a sure warrant of success."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "선생님은 톰에게 부지런하다고 상을 주셨다.",
      "text": "The teacher rewarded Tom for his <b>diligence</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "그는 공부는 열심히 했건마는 낙제했다",
      "text": "He was plucked notwithstanding his great <b>diligence</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:1.000000",
      "translatedText": "정직과 근면은 그의 처세 원칙이다",
      "text": "Honesty and <b>diligence</b> are the guiding principles of his life."
    }
  ],
