  "examples": [
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "부엉이 소리도 제가 듣기에는 좋다",
      "text": "We are apt to be blind to our own <b>defects</b>[faults]."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그는 자신의 조국에서 서방 세계로 넘어왔다",
      "text": "He defected from his country to the West."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그는 사지를 넘어 자유 세계로 귀순했다",
      "text": "He defected to the Free World across the point of death."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "그는 언어 장애 때문에 변호사 되기를 단념했다",
      "text": "He gave up becoming a lawyer on account of a speech <b>defect</b>."
    },
    {
      "source": "동아출판 프라임 영한사전",
      "matchType": "allterm:proximity:0.000000",
      "translatedText": "오체가 멀쩡하다",
      "text": "He is without any physical <b>defect</b>."
    }
