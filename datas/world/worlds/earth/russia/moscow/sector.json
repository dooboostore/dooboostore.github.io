  "info": {
    "붉은광장": {"title": "붉은광장", "emoji": "🟥", "kind": "지명", "desc": "크렘린 바로 옆의 넓은 광장이에요. 여기서 \"붉은\"은 옛 러시아어로 \"아름다운\"이라는 뜻이기도 해요."},
    "성 바실리 대성당": {"title": "성 바실리 대성당", "emoji": "⛪", "kind": "지명", "desc": "1555년에서 1561년 사이에 지어진 성당이에요. 알록달록한 양파 모양 지붕이 동화 속 성처럼 보여요."},
    "크렘린": {"title": "크렘린", "emoji": "🏰", "kind": "지명", "desc": "붉은 벽돌 성벽으로 둘러싸인 옛 요새이자 궁전 단지예요. 스파스카야 탑의 시계가 광장을 내려다보고 있어요."},
    "볼쇼이 극장": {"title": "볼쇼이 극장", "emoji": "🩰", "kind": "지명", "desc": "발레와 오페라로 이름난 극장이에요. 기둥이 늘어선 정면 위로 마차를 탄 아폴론 조각이 서 있어요."},
    "아르바트 거리": {"title": "아르바트 거리", "emoji": "🎨", "kind": "지명", "desc": "오래된 보행자 거리예요. 거리 화가와 음악가, 기념품 가게가 늘어서 있어요."},
    "고리키 공원": {"title": "고리키 공원", "emoji": "🌳", "kind": "지명", "desc": "모스크바강을 따라 펼쳐진 큰 공원이에요. 여름엔 자전거와 산책, 겨울엔 커다란 스케이트장이 열려요."},
    "구세주 그리스도 대성당": {"title": "구세주 그리스도 대성당", "emoji": "⛪", "kind": "지명", "desc": "금빛 돔이 빛나는 커다란 성당이에요. 1931년에 무너졌다가 1990년대에 다시 지어졌어요."},
    "트레티야코프 미술관": {"title": "트레티야코프 미술관", "emoji": "🖼️", "kind": "지명", "desc": "러시아 미술을 모아 둔 미술관이에요. 상인 파벨 트레티야코프의 수집품에서 시작됐어요."},
    "모스크바강": {"title": "모스크바강", "emoji": "🌊", "kind": "지명", "desc": "도시를 굽이굽이 가로지르는 강이에요. 유람선을 타고 크렘린과 공원을 지나갈 수 있어요."}
  }
