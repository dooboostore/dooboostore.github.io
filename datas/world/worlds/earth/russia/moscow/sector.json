  "labels": [
    {"text": {"ko": "붉은광장", "en": "Red Square", "zh": "红场"}, "at": [560.0, 350.0], "size": 12.0, "info": {"emoji": "🟥", "kind": "지명", "title": {"ko": "붉은광장", "en": "Red Square", "zh": "红场"}, "desc": {"ko": "크렘린 바로 옆의 넓은 광장이에요. 여기서 \"붉은\"은 옛 러시아어로 \"아름다운\"이라는 뜻이기도 해요.", "en": "A wide square right next to the Kremlin. Here, \"red\" also means \"beautiful\" in old Russian.", "zh": "紧挨着克里姆林宫的宽阔广场。这里的“红”在古俄语中也有“美丽”的意思。"}}},
    {"text": {"ko": "성 바실리 대성당", "en": "St. Basil's Cathedral", "zh": "圣瓦西里大教堂"}, "at": [545.0, 408.0], "size": 8.0, "info": {"emoji": "⛪", "kind": "지명", "title": {"ko": "성 바실리 대성당", "en": "St. Basil's Cathedral", "zh": "圣瓦西里大教堂"}, "desc": {"ko": "1555년에서 1561년 사이에 지어진 성당이에요. 알록달록한 양파 모양 지붕이 동화 속 성처럼 보여요.", "en": "A cathedral built between 1555 and 1561. Its colourful onion-shaped domes make it look like a castle from a fairy tale.", "zh": "建于1555年至1561年间的教堂。五彩缤纷的洋葱形圆顶让它看起来像童话里的城堡。"}}},
    {"text": {"ko": "크렘린", "en": "Kremlin", "zh": "克里姆林宫"}, "at": [452.0, 372.0], "size": 9.0, "info": {"emoji": "🏰", "kind": "지명", "title": {"ko": "크렘린", "en": "Kremlin", "zh": "克里姆林宫"}, "desc": {"ko": "붉은 벽돌 성벽으로 둘러싸인 옛 요새이자 궁전 단지예요. 스파스카야 탑의 시계가 광장을 내려다보고 있어요.", "en": "An old fortress and palace complex surrounded by red brick walls. The clock on the Spasskaya Tower looks down over the square.", "zh": "被红砖城墙环绕的古老要塞和宫殿建筑群。斯帕斯卡亚塔上的大钟俯瞰着广场。"}}},
    {"text": {"ko": "볼쇼이 극장", "en": "Bolshoi Theatre", "zh": "大剧院"}, "at": [502.3, 305.6], "size": 9.0, "info": {"emoji": "🩰", "kind": "지명", "title": {"ko": "볼쇼이 극장", "en": "Bolshoi Theatre", "zh": "大剧院"}, "desc": {"ko": "발레와 오페라로 이름난 극장이에요. 기둥이 늘어선 정면 위로 마차를 탄 아폴론 조각이 서 있어요.", "en": "A theatre famous for ballet and opera. Above its columned front stands a sculpture of Apollo riding a chariot.", "zh": "以芭蕾和歌剧闻名的剧院。立柱林立的正面上方矗立着驾驭马车的阿波罗雕塑。"}}},
    {"text": {"ko": "아르바트 거리", "en": "Arbat Street", "zh": "阿尔巴特街"}, "at": [344.4, 410.7], "size": 9.0, "info": {"emoji": "🎨", "kind": "지명", "title": {"ko": "아르바트 거리", "en": "Arbat Street", "zh": "阿尔巴特街"}, "desc": {"ko": "오래된 보행자 거리예요. 거리 화가와 음악가, 기념품 가게가 늘어서 있어요.", "en": "An old pedestrian street. Street painters, musicians and souvenir shops line the way.", "zh": "一条古老的步行街。街头画家、音乐家和纪念品店排列两旁。"}}},
    {"text": {"ko": "고리키 공원", "en": "Gorky Park", "zh": "高尔基公园"}, "at": [418.9, 571.8], "size": 9.0, "info": {"emoji": "🌳", "kind": "지명", "title": {"ko": "고리키 공원", "en": "Gorky Park", "zh": "高尔基公园"}, "desc": {"ko": "모스크바강을 따라 펼쳐진 큰 공원이에요. 여름엔 자전거와 산책, 겨울엔 커다란 스케이트장이 열려요.", "en": "A big park stretching along the Moskva River. In summer there's cycling and strolling, and in winter a huge skating rink opens.", "zh": "沿着莫斯科河展开的大公园。夏天可以骑车散步，冬天会开放巨大的溜冰场。"}}},
    {"text": {"ko": "구세주 그리스도 대성당", "en": "Cathedral of Christ the Saviour", "zh": "救世主基督大教堂"}, "at": [420.0, 440.0], "size": 8.0, "info": {"emoji": "⛪", "kind": "지명", "title": {"ko": "구세주 그리스도 대성당", "en": "Cathedral of Christ the Saviour", "zh": "救世主基督大教堂"}, "desc": {"ko": "금빛 돔이 빛나는 커다란 성당이에요. 1931년에 무너졌다가 1990년대에 다시 지어졌어요.", "en": "A huge cathedral with shining golden domes. It was demolished in 1931 and rebuilt in the 1990s.", "zh": "金色圆顶闪闪发光的大教堂。它在1931年被拆毁，20世纪90年代重新建成。"}}},
    {"text": {"ko": "트레티야코프 미술관", "en": "Tretyakov Gallery", "zh": "特列季亚科夫画廊"}, "at": [509.6, 456.8], "size": 9.0, "info": {"emoji": "🖼️", "kind": "지명", "title": {"ko": "트레티야코프 미술관", "en": "Tretyakov Gallery", "zh": "特列季亚科夫画廊"}, "desc": {"ko": "러시아 미술을 모아 둔 미술관이에요. 상인 파벨 트레티야코프의 수집품에서 시작됐어요.", "en": "An art museum that collects Russian art. It began with the collection of the merchant Pavel Tretyakov.", "zh": "收藏俄罗斯美术作品的美术馆。它起源于商人帕维尔·特列季亚科夫的收藏。"}}},
    {"text": {"ko": "모스크바강", "en": "Moskva River", "zh": "莫斯科河"}, "at": [590.0, 425.0], "size": 9.0, "info": {"emoji": "🌊", "kind": "지명", "title": {"ko": "모스크바강", "en": "Moskva River", "zh": "莫斯科河"}, "desc": {"ko": "도시를 굽이굽이 가로지르는 강이에요. 유람선을 타고 크렘린과 공원을 지나갈 수 있어요.", "en": "A river that winds its way across the city. You can take a boat past the Kremlin and parks.", "zh": "蜿蜒穿过城市的河流。可以乘游船经过克里姆林宫和公园。"}}}
  ]
}
