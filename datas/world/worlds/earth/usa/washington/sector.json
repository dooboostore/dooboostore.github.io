  "info": {
    "록 크리크 공원": {"title": "록 크리크 공원", "emoji": "🌲", "kind": "지명", "desc": "워싱턴 도심을 가로지르는 숲 공원으로, 1890년에 조성되었어요. 개울을 따라 산책로와 자전거길이 이어지고, 국립동물원도 이 공원과 맞닿아 있어요."},
    "내셔널 몰": {"title": "내셔널 몰", "emoji": "🏛️", "kind": "지명", "desc": "국회의사당에서 링컨 기념관까지 길게 뻗은 잔디 광장이에요. 양옆으로 스미소니언 박물관들이 늘어서 있는데, 대부분 무료로 들어갈 수 있답니다."},
    "조지타운": {"title": "조지타운", "emoji": "🏘️", "kind": "지명", "desc": "워싱턴 D.C.보다 먼저 생긴 오래된 항구 마을 조지타운이에요. 알록달록한 연립주택과 자갈길, 운하가 남아 있어 산책하기 좋아요."},
    "캐피톨 힐": {"title": "캐피톨 힐", "emoji": "🏛️", "kind": "지명", "desc": "미 국회의사당이 서 있는 언덕과 그 주변 동네예요. 의회 도서관과 연방 대법원도 가까이 있고, 조용한 주택가에는 오래된 연립주택이 줄지어 있어요."},
    "애너코스티아": {"title": "애너코스티아", "emoji": "🌳", "kind": "지명", "desc": "애너코스티아강 동쪽에 자리한 동네예요. 노예제 폐지 운동가 프레더릭 더글러스가 말년을 보낸 집이 남아 있어요. 강변 공원에서 여유를 즐길 수 있어요."},
    "포토맥강": {"title": "포토맥강", "emoji": "🌊", "kind": "지명", "desc": "워싱턴 D.C.의 서쪽을 흐르는 포토맥강이에요. 강 건너는 버지니아주이고, 카약과 조정 보트가 강 위를 수놓아요. 강변 공원에 앉아 물 위를 지나는 보트를 바라보면 마음이 느긋해져요."},
    "듀폰 서클": {"title": "듀폰 서클", "emoji": "⛲", "kind": "지명", "desc": "가운데 분수가 있는 원형 광장 듀폰 서클이에요. 주변에는 대사관과 서점, 카페가 모여 있고, 광장에서 체스를 두는 사람들도 볼 수 있어요."},
    "타이달 베이슨": {"title": "타이달 베이슨", "emoji": "🌸", "kind": "지명", "desc": "포토맥강 물이 드나드는 인공 호수 타이달 베이슨이에요. 둘레에 1912년 일본에서 선물한 벚나무가 심겨 있어 봄이면 분홍빛으로 물들어요. 제퍼슨 기념관도 호숫가에 있어요."},
    "네이비 야드": {"title": "네이비 야드", "emoji": "⚓", "kind": "지명", "desc": "1799년에 세워진 미 해군 조선소에서 이름이 온 동네예요. 지금은 강변 공원과 야구장 내셔널스 파크가 들어선 활기찬 지역이 되었어요."}
  }
}
