  "info": {
    "맨해튼": {"title": "맨해튼", "emoji": "🏙️", "kind": "지명", "desc": "뉴욕의 심장 맨해튼이에요. 허드슨강과 이스트강 사이의 길쭉한 섬에 마천루와 센트럴 파크, 브로드웨이가 모여 있어요. 바둑판처럼 반듯하게 나뉜 길 덕분에 길 찾기가 생각보다 쉬워요."},
    "브루클린": {"title": "브루클린", "emoji": "🌉", "kind": "지명", "desc": "뉴욕에서 인구가 가장 많은 자치구 브루클린이에요. 브라운스톤 주택가와 공원, 강변에서 바라보는 맨해튼 스카이라인이 멋져요. 작은 카페와 벼룩시장이 많아 주말 산책에 딱 좋아요."},
    "퀸스": {"title": "퀸스", "emoji": "✈️", "kind": "지명", "desc": "뉴욕에서 면적이 가장 넓은 자치구 퀸스예요. 세계 각국에서 온 이민자들이 모여 살아 다양한 언어와 음식을 만날 수 있어요. JFK와 라과디아 공항도 퀸스에 있어요."},
    "브롱크스": {"title": "브롱크스", "emoji": "⚾", "kind": "지명", "desc": "뉴욕 맨 북쪽의 자치구 브롱크스예요. 양키 스타디움과 브롱크스 동물원, 뉴욕 식물원이 있어요. 힙합이 태어난 곳으로도 알려져 있어요."},
    "스태튼 아일랜드": {"title": "스태튼 아일랜드", "emoji": "⛴️", "kind": "지명", "desc": "뉴욕만 남서쪽의 섬 자치구예요. 맨해튼과 잇는 스태튼 아일랜드 페리는 무료로 탈 수 있는데, 가는 길에 자유의 여신상이 보여 인기가 많아요."},
    "센트럴 파크": {"title": "센트럴 파크", "emoji": "🌳", "kind": "지명", "desc": "맨해튼 한가운데의 커다란 도시 공원이에요. 옴스테드와 보가 설계했고, 호수와 잔디밭, 산책로가 빌딩 숲 사이에 숨 쉴 틈을 만들어 줘요."},
