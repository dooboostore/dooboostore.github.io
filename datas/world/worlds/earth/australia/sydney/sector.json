  "info": {
    "오페라 하우스": {"title": "오페라 하우스", "emoji": "🎭", "kind": "지명", "desc": "돛 모양 지붕이 바다와 어우러진 시드니 오페라 하우스예요. 1973년에 문을 열었고, 2007년 유네스코 세계유산이 되었어요. 매년 수많은 공연이 열려요."},
    "하버 브리지": {"title": "하버 브리지", "emoji": "🌉", "kind": "지명", "desc": "1932년에 개통한 시드니 하버 브리지예요. 아치 위를 걸어 오르는 '브리지 클라임'으로 꼭대기에서 항구를 내려다볼 수도 있어요."},
    "서큘러 키": {"title": "서큘러 키", "emoji": "⛴️", "kind": "지명", "desc": "시드니 페리가 출발하는 항구 서큘러 키예요. 오페라 하우스와 하버 브리지 사이에 있어서 거리 공연을 보며 항구 풍경을 즐기기 좋아요."},
    "더 록스": {"title": "더 록스", "emoji": "🏚️", "kind": "지명", "desc": "1788년 영국 함대가 도착해 정착을 시작한 곳 근처의 오래된 동네예요. 사암 건물과 좁은 골목, 주말 시장이 옛 시드니의 분위기를 전해 줘요."},
    "달링 하버": {"title": "달링 하버", "emoji": "🎆", "kind": "지명", "desc": "시드니 도심 서쪽의 항구 놀이 공간이에요. 수족관과 박물관, 식당이 물가를 따라 늘어서 있고, 주말 밤엔 불꽃놀이가 열리기도 해요."},
    "하이드 파크": {"title": "하이드 파크", "emoji": "🌳", "kind": "지명", "desc": "1810년에 조성된 호주에서 가장 오래된 공원이에요. 무화과나무 가로수 길이 시원한 그늘을 만들고, 아치볼드 분수가 공원을 꾸며요."},
    "왕립 식물원": {"title": "왕립 식물원", "emoji": "🌺", "kind": "지명", "desc": "1816년에 문을 연 시드니 왕립 식물원이에요. 오페라 하우스 바로 옆 바닷가에 있어서, 잔디밭에 앉아 항구를 바라보며 쉬기 좋아요."},
    "차이나타운": {"title": "차이나타운", "emoji": "🏮", "kind": "지명", "desc": "시드니 도심 남쪽의 차이나타운이에요. 붉은 패루 문을 지나면 아시아 음식점과 금요일 밤 야시장이 반겨 줘요. 다양한 아시아 문화가 어우러져 늘 맛있는 냄새가 가득해요."},
    "센트럴역": {"title": "센트럴역", "emoji": "🚉", "kind": "지명", "desc": "시드니 교통의 중심인 센트럴역이에요. 사암으로 지은 시계탑이 상징이고, 장거리 기차와 지하철, 트램이 이곳에서 만나요. 1906년 문을 연 오래된 역이에요."},
    "울루물루": {"title": "울루물루", "emoji": "⚓", "kind": "지명", "desc": "시드니 항구 안쪽의 바닷가 동네예요. 옛 부두를 고쳐 만든 긴 나무 부두 '핑거 와프'가 유명하고, 항구 앞 파이 가게도 사랑받아요."}
  }
