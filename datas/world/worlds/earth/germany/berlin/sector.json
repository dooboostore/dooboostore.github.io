  "info": {
    "브란덴부르크 문": {"title": "브란덴부르크 문", "emoji": "🏛️", "kind": "지명", "desc": "1791년에 완성된 문으로, 꼭대기에 네 마리 말이 끄는 전차 조각이 있어요. 베를린 장벽이 무너진 뒤 하나 된 독일의 상징이 되었어요."},
    "베를린 TV탑": {"title": "베를린 TV탑", "emoji": "🗼", "kind": "지명", "desc": "1969년에 문을 연 높이 368m의 탑이에요. 동그란 구 안의 전망대와 회전 레스토랑에서 도시 전체가 보여요."},
    "국회의사당": {"title": "국회의사당", "emoji": "🏛️", "kind": "지명", "desc": "독일 연방의회가 열리는 건물이에요. 유리 돔 안의 나선 길을 따라 올라가면 회의장도 내려다볼 수 있어요."},
    "박물관섬": {"title": "박물관섬", "emoji": "🏺", "kind": "지명", "desc": "슈프레강 가운데 섬에 박물관 다섯 곳이 모여 있어요. 1999년 유네스코 세계유산이 되었어요."},
    "알렉산더 광장": {"title": "알렉산더 광장", "emoji": "🕰️", "kind": "지명", "desc": "TV탑 아래의 큰 광장이에요. 세계 여러 도시의 시간을 보여 주는 세계시계가 만남의 장소예요."},
    "티어가르텐": {"title": "티어가르텐", "emoji": "🌳", "kind": "지명", "desc": "도심 한가운데 펼쳐진 아주 큰 공원이에요. 숲길과 호수가 있어 시민들이 산책과 자전거를 즐겨요."},
    "체크포인트 찰리": {"title": "체크포인트 찰리", "emoji": "🚧", "kind": "지명", "desc": "베를린이 나뉘어 있던 시절 동서를 오가던 검문소 자리예요. 지금은 작은 초소 모형과 박물관이 남아 있어요."},
    "슈프레강": {"title": "슈프레강", "emoji": "🌊", "kind": "지명", "desc": "베를린을 가로지르는 강이에요. 유람선을 타면 박물관섬과 국회의사당 옆을 지나가요."},
    "포츠담 광장": {"title": "포츠담 광장", "emoji": "🏙️", "kind": "지명", "desc": "장벽이 있던 빈터에 새로 지은 빌딩 거리예요. 영화제가 열리는 극장과 쇼핑몰이 모여 있어요."}
