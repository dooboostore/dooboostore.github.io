  "info": {
    "타이베이 101": {"title": "타이베이 101", "emoji": "🏙️", "kind": "지명", "desc": "2004년 문을 연 높이 508m의 초고층 빌딩이에요. 대나무 마디처럼 여덟 칸씩 쌓아 올린 모양이고, 해마다 새해 불꽃놀이로 유명해요."},
    "중정기념당": {"title": "중정기념당", "emoji": "🏛️", "kind": "지명", "desc": "1980년에 문을 연 기념관으로, 흰 벽과 파란 팔각 지붕이 눈에 띄어요. 넓은 광장에서는 근위병 교대식도 볼 수 있어요."},
    "룽산사": {"title": "룽산사", "emoji": "🏮", "kind": "지명", "desc": "1738년에 세워진 타이베이에서 손꼽히는 오래된 절이에요. 화려한 용 장식 지붕 아래로 늘 향 냄새가 은은하게 퍼져요."},
    "스린 야시장": {"title": "스린 야시장", "emoji": "🍢", "kind": "지명", "desc": "타이베이에서 가장 큰 야시장 가운데 하나예요. 지파이, 버블티, 굴전 같은 간식 냄새를 따라 밤늦게까지 사람들이 북적여요."},
    "시먼딩": {"title": "시먼딩", "emoji": "🛍️", "kind": "지명", "desc": "젊은이들이 모이는 보행자 거리예요. 작은 가게와 거리 공연이 이어져서 걷기만 해도 즐거운 곳이에요."},
    "총통부": {"title": "총통부", "emoji": "🏢", "kind": "지명", "desc": "붉은 벽돌로 지은 정부 청사예요. 높은 중앙 탑이 있는 건물로, 옛 시가지 한가운데 자리하고 있어요."},
    "양밍산": {"title": "양밍산", "emoji": "⛰️", "kind": "지명", "desc": "타이베이 북쪽의 국립공원이에요. 화산 지형이라 온천이 많고, 봄이면 꽃이 가득 피어요."},
    "단수이강": {"title": "단수이강", "emoji": "🌊", "kind": "지명", "desc": "타이베이 서쪽을 흘러 바다로 가는 강이에요. 강가를 따라 자전거 길과 노을 명소가 이어져요."},
    "국립고궁박물원": {"title": "국립고궁박물원", "emoji": "🏺", "kind": "지명", "desc": "중국 역대 왕조의 귀한 유물을 모은 박물관이에요. 배추 모양 옥 조각 같은 보물로 유명해요."}
  }
