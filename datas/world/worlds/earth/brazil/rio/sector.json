  "info": {
    "그리스도상": {"title": "그리스도상", "emoji": "✝️", "kind": "지명", "desc": "코르코바두 언덕 위의 그리스도상이에요. 1931년에 완성되었고, 두 팔을 벌려 리우 시내를 감싸 안는 듯한 모습이에요. 2007년 신 세계 7대 불가사의에 뽑혔어요."},
    "슈거로프": {"title": "슈거로프", "emoji": "⛰️", "kind": "지명", "desc": "과나바라만 입구의 바위산 팡 지 아수카르예요. 1912년에 시작된 케이블카를 타고 오르면 리우의 해변과 그리스도상이 한눈에 들어와요."},
    "코파카바나": {"title": "코파카바나", "emoji": "🏖️", "kind": "지명", "desc": "약 4km에 걸친 리우의 대표 해변 코파카바나예요. 물결무늬 보도가 해변을 따라 이어지고, 새해 전야에는 바다 위 불꽃놀이로 유명해요."},
    "보타포구": {"title": "보타포구", "emoji": "⛵", "kind": "지명", "desc": "과나바라만 안쪽의 동네 보타포구예요. 요트가 떠 있는 잔잔한 만 너머로 슈거로프 산이 보여 사진 명소로 꼽혀요. 저녁이면 근처 거리의 작은 술집과 식당들이 활기를 띠어요."},
    "이파네마": {"title": "이파네마", "emoji": "🌅", "kind": "지명", "desc": "노래 '이파네마의 소녀'로 세계에 알려진 해변이에요. 해 질 녘이면 사람들이 바위에 모여 노을을 보며 박수를 치는 정겨운 풍경이 펼쳐져요."},
    "리우데자네이루": {"title": "리우데자네이루", "emoji": "🏖️", "kind": "지명", "desc": "'1월의 강'이라는 뜻의 이름을 가진 리우데자네이루예요. 산과 바다, 숲이 도시와 어우러진 풍경은 2012년 유네스코 세계유산이 되었어요."}
  }
