  "info": {
    "한라산": {"title": "한라산", "emoji": "🏔️", "kind": "지명", "desc": "제주도 한가운데 솟은 높이 1,947m의 한라산이에요. 남한에서 가장 높은 산이고, 정상에는 분화구 호수 백록담이 있어요. 계절마다 다른 옷으로 갈아입는 산이랍니다."},
    "성산일출봉": {"title": "성산일출봉", "emoji": "🌄", "kind": "지명", "desc": "바다에서 솟아오른 화산 분화구 봉우리 성산일출봉이에요. 이름처럼 해돋이 명소로 유명하고, 유네스코 세계자연유산의 일부예요. 정상의 넓은 분화구가 장관이에요."},
    "협재": {"title": "협재", "emoji": "🏖️", "kind": "지명", "desc": "에메랄드빛 바다와 하얀 모래가 아름다운 협재 해수욕장이에요. 바다 건너로 작은 섬 비양도가 보여서 노을 질 때 특히 그림 같아요."},
    "중문": {"title": "중문", "emoji": "🌴", "kind": "지명", "desc": "제주 남쪽의 관광 단지 중문이에요. 해변과 리조트가 모여 있고, 근처에는 육각기둥 바위가 늘어선 대포 주상절리대가 있어요. 천제연폭포도 가까이 있어 하루 종일 둘러보기 좋아요."},
    "서귀포": {"title": "서귀포", "emoji": "🌊", "kind": "지명", "desc": "제주 남쪽의 도시 서귀포예요. 바다로 바로 떨어지는 정방폭포와 천지연폭포가 있고, 따뜻한 날씨 덕분에 귤 향기가 가득해요. 앞바다에는 섶섬, 문섬, 범섬 같은 작은 섬들이 떠 있어요."},
    "제주시": {"title": "제주시", "emoji": "🏙️", "kind": "지명", "desc": "제주도 북쪽의 중심 도시 제주시예요. 공항과 항구가 있어 제주 여행의 시작점이 되고, 동문시장에서는 싱싱한 귤과 해산물을 만날 수 있어요."},
    "우도": {"title": "우도", "emoji": "🐄", "kind": "지명", "desc": "제주 동쪽의 작은 섬 우도예요. 소가 누워 있는 모양을 닮아 이런 이름이 붙었대요. 땅콩 아이스크림과 하얀 산호 모래 해변이 유명해요."},
    "만장굴": {"title": "만장굴", "emoji": "🕳️", "kind": "지명", "desc": "화산이 만든 용암동굴 만장굴이에요. 일부 구간이 공개되어 있고, 동굴 끝 무렵에는 큰 용암 석주가 있어요. 유네스코 세계자연유산 '거문오름 용암동굴계'의 하나예요."},
    "함덕": {"title": "함덕", "emoji": "🏖️", "kind": "지명", "desc": "제주 북동쪽의 함덕 해수욕장이에요. 얕고 맑은 바다가 넓게 펼쳐져 아이들과 물놀이하기 좋고, 옆의 서우봉에 오르면 바다가 한눈에 보여요."},
    "김녕": {"title": "김녕", "emoji": "🌊", "kind": "지명", "desc": "제주 북동쪽의 바닷가 마을 김녕이에요. 투명한 바다와 검은 현무암이 어우러지고, 해녀들이 물질하는 모습을 볼 수 있는 마을이랍니다."},
    "사려니숲": {"title": "사려니숲", "emoji": "🌲", "kind": "지명", "desc": "삼나무와 졸참나무가 우거진 사려니숲길이에요. '사려니'는 신성한 곳이라는 뜻이라고 해요. 숲속 흙길을 걸으면 피톤치드 향이 마음을 차분하게 해 줘요."},
    "감귤밭": {"title": "감귤밭", "emoji": "🍊", "kind": "지명", "desc": "돌담에 둘러싸인 제주의 감귤밭이에요. 겨울이면 귤이 주황빛으로 익어 귤 따기 체험도 할 수 있어요. 돌담은 거센 바닷바람을 막아 주는 제주의 지혜랍니다."}
  }
}
