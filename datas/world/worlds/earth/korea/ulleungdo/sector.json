  "info": {
    "성인봉": {"title": "성인봉", "emoji": "⛰️", "kind": "지명", "desc": "울릉도에서 가장 높은 봉우리 성인봉이에요. 원시림이 우거진 등산로를 오르면 섬과 동해가 발아래 펼쳐져요. 정상에서 북쪽으로 나리분지가 내려다보여요."},
    "나리분지": {"title": "나리분지", "emoji": "🌾", "kind": "지명", "desc": "울릉도에서 거의 유일하게 넓은 평지인 나리분지예요. 화산 분화구가 내려앉아 생긴 땅이에요. 전통 너와집과 투막집도 남아 있어요."},
    "도동항": {"title": "도동항", "emoji": "⚓", "kind": "지명", "desc": "울릉도의 관문 도동항이에요. 육지에서 오는 여객선이 닿는 곳으로, 좁은 골짜기를 따라 가게와 숙소가 빼곡히 들어서 있어요. 항구 옆 해안 산책로를 따라 걸으면 맑은 바닷속이 훤히 보여요."},
    "저동항": {"title": "저동항", "emoji": "🦑", "kind": "지명", "desc": "울릉도 동쪽의 어항 저동항이에요. 오징어잡이 배들의 보금자리로, 밤바다를 밝히는 집어등 불빛이 아름다워요. 촛대바위도 이곳에 있어요."},
    "태하": {"title": "태하", "emoji": "🗼", "kind": "지명", "desc": "울릉도 서쪽의 마을 태하예요. 모노레일을 타고 오르면 태하등대와 해안 절벽 전망대가 나오는데, 이곳 풍경은 울릉도 최고의 절경으로 꼽혀요."},
    "코끼리바위": {"title": "코끼리바위", "emoji": "🐘", "kind": "지명", "desc": "코끼리가 바다에 코를 담근 모양의 바위예요. 기둥 모양 주상절리로 이루어졌고, 가운데 뚫린 구멍이 코끼리 코와 몸 사이처럼 보여요. 유람선에서 볼 수 있어요."},
    "관음도": {"title": "관음도", "emoji": "🌉", "kind": "지명", "desc": "울릉도 북동쪽의 작은 섬 관음도예요. 보행 연도교로 울릉도와 연결되어 걸어서 들어갈 수 있어요. 섬 위 산책길에서 바라보는 바다가 시원해요."}
  }
