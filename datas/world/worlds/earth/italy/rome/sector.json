  "info": {
    "콜로세움": {"title": "콜로세움", "emoji": "🏟️", "kind": "지명", "desc": "서기 80년에 문을 연 고대 로마의 원형 경기장이에요. 검투사 경기가 열리던 곳으로, 지금도 로마를 대표하는 풍경이에요. 약 5만 명의 관중이 들어갈 수 있었다고 해요."},
    "트레비 분수": {"title": "트레비 분수", "emoji": "⛲", "kind": "지명", "desc": "로마에서 가장 큰 바로크 분수예요. 동전을 등 뒤로 던지면 다시 로마에 온다는 전설이 있어요. 밤에 조명이 켜지면 더욱 아름다워요."},
    "판테온": {"title": "판테온", "emoji": "🏛️", "kind": "지명", "desc": "약 2천 년 전에 지금 모습으로 지어진 신전이에요. 둥근 돔 꼭대기 구멍으로 햇빛이 쏟아지고, 비 오는 날엔 빗방울이 그대로 떨어져요. 바닥에는 물 빠지는 구멍이 있대요."},
    "바티칸": {"title": "바티칸", "emoji": "⛪", "kind": "지명", "desc": "로마 안에 있는 세계에서 가장 작은 나라 바티칸 시국이에요. 교황이 사는 곳으로, 성 베드로 대성당과 시스티나 성당의 미켈란젤로 천장화가 있어요."},
    "포로 로마노": {"title": "포로 로마노", "emoji": "🏛️", "kind": "지명", "desc": "고대 로마의 정치와 생활의 중심이던 광장 유적이에요. 신전과 개선문, 기둥들이 남아 있어 2천 년 전 로마 사람들의 하루를 상상해 볼 수 있어요."},
    "스페인 광장": {"title": "스페인 광장", "emoji": "🪜", "kind": "지명", "desc": "넓은 스페인 계단이 있는 광장이에요. 근처에 스페인 대사관이 있어 이런 이름이 붙었어요. 영화 '로마의 휴일'에서 젤라토를 먹던 장면으로 유명해요."},
    "나보나": {"title": "나보나", "emoji": "⛲", "kind": "지명", "desc": "고대 도미티아누스 경기장 터를 따라 길쭉한 모양이 된 나보나 광장이에요. 가운데에는 베르니니의 '4대 강의 분수'가 있고, 거리 화가와 악사들로 활기차요."},
    "트라스테베레": {"title": "트라스테베레", "emoji": "🍝", "kind": "지명", "desc": "테베레강 건너편의 옛 골목 동네예요. 담쟁이 덮인 집과 자갈길 사이로 작은 식당이 많아서 저녁이면 로마 사람들의 웃음소리로 가득해요."}
  }
