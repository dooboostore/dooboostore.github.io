{
  "name": "dooboostore-center",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "pnpm dlx http-server dist -p 8080",
    "dev": "webpack serve --mode development --config webpack.config.cjs",
    "build": "webpack --mode production --config webpack.config.cjs",
    "load-html": "webpack --config webpack.ssr.config.cjs && node dist-ssr/load-html.cjs",
    "load-html:build": "webpack --config webpack.ssr.config.cjs",
    "load-html:dev": "webpack --config webpack.ssr.config.cjs --watch",
    "test": "webpack --config webpack.test.config.cjs && node --test dist-test/strategy.test.cjs"
  },
  "dependencies": {
    "@dooboostore/algorithm": "workspace:*",
    "@dooboostore/core": "workspace:*",
    "@dooboostore/core-web": "workspace:*",
    "@dooboostore/dom-parser": "workspace:*",
    "@dooboostore/simple-boot": "workspace:*",
    "@dooboostore/simple-boot-front": "workspace:*",
    "@dooboostore/simple-web-component": "workspace:*",
    "@dooboostore/simple-web-component-library": "workspace:*",    "highlight.js": "^11.9.0",
    "lz-string": "^1.5.0",
    "marked": "^12.0.0",
    "marked-highlight": "^2.1.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/marked": "^4.0.0",
    "@types/node": "^20.0.0",
    "copy-webpack-plugin": "^12.0.2",
    "html-webpack-plugin": "^5.6.3",
    "ts-loader": "^9.5.1",
    "tslib": "^2.8.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "webpack": "^5.93.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.0"
  }
}
