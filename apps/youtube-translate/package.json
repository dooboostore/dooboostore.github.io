{
  "name": "dooboostore-youtube-translate",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node dist/index.cjs",
    "build:start": "pnpm run build && pnpm run start",
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --dev",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@dooboostore/core": "workspace:*",
    "@dooboostore/core-web": "workspace:*",
    "@dooboostore/simple-boot": "workspace:*",
    "@dooboostore/simple-boot-front": "workspace:*",
    "@dooboostore/simple-web-component": "workspace:*",
    "dooboostore-english-dictionary": "workspace:*",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.0",
    "marked-highlight": "^2.1.1",
    "playwright": "^1.56.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/marked": "^4.0.0",
    "esbuild": "^0.23.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2"
  }
}
